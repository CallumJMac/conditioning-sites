  "pairs": {
    "p00": {
      "id": "p00",
      "system": "qwen17",
      "arm": "pathway_libritts",
      "speaker_id": "6930",
      "target_id": "6930_76324_000020_000000",
      "text": "\"Of course not,\" said Joyce.",
      "icl": "audio/pairs/p00/icl.wav",
      "xvec": "audio/pairs/p00/xvec.wav",
      "reference": "audio/pairs/p00/reference.wav",
      "icl_job_id": "baa6c70877b8bf21",
      "xvec_job_id": "7fd0d359beb5a67c"
    },
    "p01": {
      "id": "p01",
      "system": "qwen17",
      "arm": "pathway_libritts",
      "speaker_id": "8455",
      "target_id": "8455_210777_000003_000001",
      "text": "Had Eva Crasweller not been good looking, had Jack been still at college, had Sir Kennington Oval remained in England, had Mr Bunnit and the bar keeper not succeeded in stopping my carriage on the hill,--should I have succeeded in arranging for the final departure of my old friend?",
      "icl": "audio/pairs/p01/icl.wav",
      "xvec": "audio/pairs/p01/xvec.wav",
      "reference": "audio/pairs/p01/reference.wav",
      "icl_job_id": "e63a90d8c284a598",
      "xvec_job_id": "b7b21a26701d4f40"
    },
    "p02": {
      "id": "p02",
      "system": "qwen17",
      "arm": "pathway_libritts",
      "speaker_id": "1284",
      "target_id": "1284_1181_000026_000001",
      "text": "But the Magician replied:",
      "icl": "audio/pairs/p02/icl.wav",
      "xvec": "audio/pairs/p02/xvec.wav",
      "reference": "audio/pairs/p02/reference.wav",
      "icl_job_id": "c5e3ac227b3ddc75",
      "xvec_job_id": "50805f92c4d73ec9"
    },
    "p03": {
      "id": "p03",
      "system": "qwen17",
      "arm": "pathway_libritts",
      "speaker_id": "1188",
      "target_id": "1188_133604_000018_000001",
      "text": "The brown ground beneath is left, for the most part; one touch of black is put for the hollow; two delicate lines of dark gray define the outer curve; and one little quivering touch of white draws the inner edge of the mandible.",
      "icl": "audio/pairs/p03/icl.wav",
      "xvec": "audio/pairs/p03/xvec.wav",
      "reference": "audio/pairs/p03/reference.wav",
      "icl_job_id": "37ec4e4efc8be219",
      "xvec_job_id": "b03a7d778227472e"
    },
    "p04": {
      "id": "p04",
      "system": "qwen17",
      "arm": "pathway_libritts",
      "speaker_id": "4992",
      "target_id": "4992_23283_000023_000003",
      "text": "I wish to prove my friendship to Miss Milner, but she will not suffer me-and every step that I take for her happiness, I take in the most perplexing uncertainty.\"",
      "icl": "audio/pairs/p04/icl.wav",
      "xvec": "audio/pairs/p04/xvec.wav",
      "reference": "audio/pairs/p04/reference.wav",
      "icl_job_id": "b014861568a228b7",
      "xvec_job_id": "66d0e07399699b79"
    },
    "p05": {
      "id": "p05",
      "system": "qwen17",
      "arm": "pathway_libritts",
      "speaker_id": "4446",
      "target_id": "4446_2275_000008_000000",
      "text": "Bartley bent lower over the fire.",
      "icl": "audio/pairs/p05/icl.wav",
      "xvec": "audio/pairs/p05/xvec.wav",
      "reference": "audio/pairs/p05/reference.wav",
      "icl_job_id": "b2b6f1b6f7e4886b",
      "xvec_job_id": "801c7181209d5b74"
    },
    "p06": {
      "id": "p06",
      "system": "qwen17",
      "arm": "pathway_libritts",
      "speaker_id": "3570",
      "target_id": "3570_5694_000014_000008",
      "text": "Of course the distinction is not observed with strict consistency in practice; the less debasing of the base services and the less honorific of the noble functions are not infrequently merged in the same person.",
      "icl": "audio/pairs/p06/icl.wav",
      "xvec": "audio/pairs/p06/xvec.wav",
      "reference": "audio/pairs/p06/reference.wav",
      "icl_job_id": "6e4d6c617cce7c5a",
      "xvec_job_id": "f60e338b9298b305"
    },
    "p07": {
      "id": "p07",
      "system": "qwen17",
      "arm": "pathway_libritts",
      "speaker_id": "8224",
      "target_id": "8224_274384_000005_000006",
      "text": "or hath he given us any gift?",
      "icl": "audio/pairs/p07/icl.wav",
      "xvec": "audio/pairs/p07/xvec.wav",
      "reference": "audio/pairs/p07/reference.wav",
      "icl_job_id": "8576f729034cc950",
      "xvec_job_id": "4a3b60890f254c09"
    },
    "p08": {
      "id": "p08",
      "system": "qwen17",
      "arm": "pathway_libritts",
      "speaker_id": "4507",
      "target_id": "4507_16021_000035_000000",
      "text": "Let us have compassion on the chastised.",
      "icl": "audio/pairs/p08/icl.wav",
      "xvec": "audio/pairs/p08/xvec.wav",
      "reference": "audio/pairs/p08/reference.wav",
      "icl_job_id": "1ef2f4d0bd918497",
      "xvec_job_id": "7b0e1615cb9ae72a"
    },
    "p09": {
      "id": "p09",
      "system": "qwen17",
      "arm": "pathway_libritts",
      "speaker_id": "7176",
      "target_id": "7176_88083_000022_000003",
      "text": "He tried to check his cast, but it was too late.",
      "icl": "audio/pairs/p09/icl.wav",
      "xvec": "audio/pairs/p09/xvec.wav",
      "reference": "audio/pairs/p09/reference.wav",
      "icl_job_id": "d2361add41d2fc96",
      "xvec_job_id": "5fa0a9dff98078f1"
    },
    "p10": {
      "id": "p10",
      "system": "qwen17",
      "arm": "pathway_libritts",
      "speaker_id": "5683",
      "target_id": "5683_32866_000047_000004",
      "text": "I boldly lighted my cheroot.",
      "icl": "audio/pairs/p10/icl.wav",
      "xvec": "audio/pairs/p10/xvec.wav",
      "reference": "audio/pairs/p10/reference.wav",
      "icl_job_id": "e422d2221f255f36",
      "xvec_job_id": "f7f9a3a42ef0ec1f"
    },
    "p11": {
      "id": "p11",
      "system": "qwen17",
      "arm": "pathway_libritts",
      "speaker_id": "5639",
      "target_id": "5639_40744_000022_000001",
      "text": "He embraced and comforted Leocadia, kissed his grandson, and that same day he despatched a courier to Naples, with a letter to his son, requiring him to come home instantly, for his mother and he had concluded a suitable match for him with a very beautiful lady.",
      "icl": "audio/pairs/p11/icl.wav",
      "xvec": "audio/pairs/p11/xvec.wav",
      "reference": "audio/pairs/p11/reference.wav",
      "icl_job_id": "d4e2da13a9856d72",
      "xvec_job_id": "234646d1f1e755c3"
    },
    "p12": {
      "id": "p12",
      "system": "qwen17",
      "arm": "pathway_libritts",
      "speaker_id": "7729",
      "target_id": "7729_102255_000016_000007",
      "text": "\"I have reason to believe,\" wrote one of their prominent men, \"that before to morrow morning the black flag will be hoisted, when nine out of ten will rally round it, and march without orders upon Lawrence.",
      "icl": "audio/pairs/p12/icl.wav",
      "xvec": "audio/pairs/p12/xvec.wav",
      "reference": "audio/pairs/p12/reference.wav",
      "icl_job_id": "ce5209892e07c0d2",
      "xvec_job_id": "dfd27b44a540e142"
    },
    "p13": {
      "id": "p13",
      "system": "qwen17",
      "arm": "pathway_libritts",
      "speaker_id": "2961",
      "target_id": "2961_961_000009_000000",
      "text": "TIMAEUS: Why did the Creator make the world?...He was good, and therefore not jealous, and being free from jealousy he desired that all things should be like himself.",
      "icl": "audio/pairs/p13/icl.wav",
      "xvec": "audio/pairs/p13/xvec.wav",
      "reference": "audio/pairs/p13/reference.wav",
      "icl_job_id": "eea79de21d74c051",
      "xvec_job_id": "de31d8d8ddcfb428"
    },
    "p14": {
      "id": "p14",
      "system": "qwen17",
      "arm": "pathway_libritts",
      "speaker_id": "121",
      "target_id": "121_127105_000040_000000",
      "text": "\"With this outbreak at last.\"",
      "icl": "audio/pairs/p14/icl.wav",
      "xvec": "audio/pairs/p14/xvec.wav",
      "reference": "audio/pairs/p14/reference.wav",
      "icl_job_id": "7d61d339e00ac18d",
      "xvec_job_id": "55af658087cde35b"
    },
    "p15": {
      "id": "p15",
      "system": "qwen17",
      "arm": "pathway_seedtts",
      "speaker_id": "common_voice_en_25014861",
      "target_id": "common_voice_en_25014861-common_voice_en_25014863",
      "text": "More visible enforcement of traffic regulations on motorists, bicyclists, and pedestrians has commenced.",
      "icl": "audio/pairs/p15/icl.wav",
      "xvec": "audio/pairs/p15/xvec.wav",
      "reference": "audio/pairs/p15/reference.wav",
      "icl_job_id": "641a23a6d94b7207",
      "xvec_job_id": "bec00b17bcb3f8a2"
    },
    "p16": {
      "id": "p16",
      "system": "qwen17",
      "arm": "pathway_seedtts",
      "speaker_id": "common_voice_en_20661858",
      "target_id": "common_voice_en_20661858-common_voice_en_20661860",
      "text": "Now I have to isolate myself for long periods.",
      "icl": "audio/pairs/p16/icl.wav",
      "xvec": "audio/pairs/p16/xvec.wav",
      "reference": "audio/pairs/p16/reference.wav",
      "icl_job_id": "46cb66ff0daa07ec",
      "xvec_job_id": "d8d6a4c650d7e248"
    },
    "p17": {
      "id": "p17",
      "system": "qwen17",
      "arm": "pathway_seedtts",
      "speaker_id": "common_voice_en_17920116",
      "target_id": "common_voice_en_17920116-common_voice_en_17920112",
      "text": "Appearances are deceptive.",
      "icl": "audio/pairs/p17/icl.wav",
      "xvec": "audio/pairs/p17/xvec.wav",
      "reference": "audio/pairs/p17/reference.wav",
      "icl_job_id": "ebe10a7ecbe9c404",
      "xvec_job_id": "5c608d629d4beb27"
    },
    "p18": {
      "id": "p18",
      "system": "qwen17",
      "arm": "pathway_seedtts",
      "speaker_id": "common_voice_en_21139160",
      "target_id": "common_voice_en_21139160-common_voice_en_21139162",
      "text": "It is believed to feed on insect larvae and termites.",
      "icl": "audio/pairs/p18/icl.wav",
      "xvec": "audio/pairs/p18/xvec.wav",
      "reference": "audio/pairs/p18/reference.wav",
      "icl_job_id": "0f3368dfa32b9422",
      "xvec_job_id": "9c473b0e849e61c0"
    },
    "p19": {
      "id": "p19",
      "system": "qwen17",
      "arm": "pathway_seedtts",
      "speaker_id": "common_voice_en_17442686",
      "target_id": "common_voice_en_17442686-common_voice_en_17442688",
      "text": "Do the roses compete in athletic events?",
      "icl": "audio/pairs/p19/icl.wav",
      "xvec": "audio/pairs/p19/xvec.wav",
      "reference": "audio/pairs/p19/reference.wav",
      "icl_job_id": "83950edb4acdef69",
      "xvec_job_id": "197a217f541ad85e"
    },
    "p20": {
      "id": "p20",
      "system": "qwen17",
      "arm": "pathway_seedtts",
      "speaker_id": "common_voice_en_120405",
      "target_id": "common_voice_en_120405-common_voice_en_120402",
      "text": "I'm never more aware of a room's acoustics than when I'm trying to enjoy a snack I have no intention of sharing.",
      "icl": "audio/pairs/p20/icl.wav",
      "xvec": "audio/pairs/p20/xvec.wav",
      "reference": "audio/pairs/p20/reference.wav",
      "icl_job_id": "ba7b361d70908f7a",
      "xvec_job_id": "b193bdebb8ff177e"
    },
    "p21": {
      "id": "p21",
      "system": "qwen17",
      "arm": "pathway_seedtts",
      "speaker_id": "common_voice_en_578084",
      "target_id": "common_voice_en_578084-common_voice_en_578102",
      "text": "It was only when I got this close to it that the strangeness of it was at all evident to me.",
      "icl": "audio/pairs/p21/icl.wav",
      "xvec": "audio/pairs/p21/xvec.wav",
      "reference": "audio/pairs/p21/reference.wav",
      "icl_job_id": "b4c7057f62c0633d",
      "xvec_job_id": "41f486b8ac0c63f2"
    },
    "p22": {
      "id": "p22",
      "system": "qwen17",
      "arm": "pathway_seedtts",
      "speaker_id": "common_voice_en_652024",
      "target_id": "common_voice_en_652024-common_voice_en_652027",
      "text": "The dragon breathed a stream of fire thirty feet long.",
      "icl": "audio/pairs/p22/icl.wav",
      "xvec": "audio/pairs/p22/xvec.wav",
      "reference": "audio/pairs/p22/reference.wav",
      "icl_job_id": "6e8d034a59ce69c8",
      "xvec_job_id": "2c731f089db4ae9a"
    },
    "p23": {
      "id": "p23",
      "system": "qwen17",
      "arm": "pathway_seedtts",
      "speaker_id": "common_voice_en_203357",
      "target_id": "common_voice_en_203357-common_voice_en_203358",
      "text": "Some of the grey ash was falling off the circular edge.",
      "icl": "audio/pairs/p23/icl.wav",
      "xvec": "audio/pairs/p23/xvec.wav",
      "reference": "audio/pairs/p23/reference.wav",
      "icl_job_id": "82b3447f9cf12efc",
      "xvec_job_id": "94781cbbb06c3922"
    },
    "p24": {
      "id": "p24",
      "system": "qwen17",
      "arm": "pathway_seedtts",
      "speaker_id": "common_voice_en_20236234",
      "target_id": "common_voice_en_20236234-common_voice_en_20236236",
      "text": "The Festival is currently based out of New York City.",
      "icl": "audio/pairs/p24/icl.wav",
      "xvec": "audio/pairs/p24/xvec.wav",
      "reference": "audio/pairs/p24/reference.wav",
      "icl_job_id": "a12082c74d55ab11",
      "xvec_job_id": "72beeb3d68050c95"
    },
    "p25": {
      "id": "p25",
      "system": "qwen17",
      "arm": "pathway_seedtts",
      "speaker_id": "common_voice_en_19665909",
      "target_id": "common_voice_en_19665909-common_voice_en_19665910",
      "text": "The Reagan administration also asked Congress to ease the rule.",
      "icl": "audio/pairs/p25/icl.wav",
      "xvec": "audio/pairs/p25/xvec.wav",
      "reference": "audio/pairs/p25/reference.wav",
      "icl_job_id": "e201fb4f33f2f650",
      "xvec_job_id": "e20a2b042afa2f01"
    },
    "p26": {
      "id": "p26",
      "system": "qwen17",
      "arm": "pathway_seedtts",
      "speaker_id": "common_voice_en_18829843",
      "target_id": "common_voice_en_18829843-common_voice_en_18829842",
      "text": "Stepping outside, he encounters four rich frat boys burning a homeless man alive.",
      "icl": "audio/pairs/p26/icl.wav",
      "xvec": "audio/pairs/p26/xvec.wav",
      "reference": "audio/pairs/p26/reference.wav",
      "icl_job_id": "a8b38d646c84793c",
      "xvec_job_id": "177c11bd5b6bb44a"
    },
    "p27": {
      "id": "p27",
      "system": "qwen17",
      "arm": "pathway_seedtts",
      "speaker_id": "common_voice_en_24009789",
      "target_id": "common_voice_en_24009789-common_voice_en_24009791",
      "text": "He was quite active in management, though his ideas were not always determinative.",
      "icl": "audio/pairs/p27/icl.wav",
      "xvec": "audio/pairs/p27/xvec.wav",
      "reference": "audio/pairs/p27/reference.wav",
      "icl_job_id": "38cc3f89794a475f",
      "xvec_job_id": "3bdc77da1fec68fd"
    },
    "p28": {
      "id": "p28",
      "system": "qwen17",
      "arm": "pathway_seedtts",
      "speaker_id": "common_voice_en_18770703",
      "target_id": "common_voice_en_18770703-common_voice_en_18770702",
      "text": "Davies started planning a second series for \"Dark Season\" that followed a similar structure.",
      "icl": "audio/pairs/p28/icl.wav",
      "xvec": "audio/pairs/p28/xvec.wav",
      "reference": "audio/pairs/p28/reference.wav",
      "icl_job_id": "0062bdbd07bc37b1",
      "xvec_job_id": "933fdd94a3dd7bc3"
    },
    "p29": {
      "id": "p29",
      "system": "qwen17",
      "arm": "pathway_seedtts",
      "speaker_id": "common_voice_en_22722937",
      "target_id": "common_voice_en_22722937-common_voice_en_22722936",
      "text": "This technique can be heard in his \"Music for Strings, Percussion and Celesta\".",
      "icl": "audio/pairs/p29/icl.wav",
      "xvec": "audio/pairs/p29/xvec.wav",
      "reference": "audio/pairs/p29/reference.wav",
      "icl_job_id": "18361f46472c5f22",
      "xvec_job_id": "5abc927fe129a564"
    },
    "p30": {
      "id": "p30",
      "system": "cosyvoice3",
      "arm": "pathway_libritts",
      "speaker_id": "4970",
      "target_id": "4970_29095_000018_000001",
      "text": "A slight frail girl like thee, study medicine! Does thee think thee could stand it six months?",
      "icl": "audio/pairs/p30/icl.wav",
      "xvec": "audio/pairs/p30/xvec.wav",
      "reference": "audio/pairs/p30/reference.wav",
      "icl_job_id": "7237eab1c6b55ad4",
      "xvec_job_id": "885f0693b38d5355"
    },
    "p31": {
      "id": "p31",
      "system": "cosyvoice3",
      "arm": "pathway_libritts",
      "speaker_id": "7176",
      "target_id": "7176_88083_000019_000000",
      "text": "The odds, however, were now laid heavily against the fugitive.",
      "icl": "audio/pairs/p31/icl.wav",
      "xvec": "audio/pairs/p31/xvec.wav",
      "reference": "audio/pairs/p31/reference.wav",
      "icl_job_id": "bd4a16891f521a84",
      "xvec_job_id": "5421a3527c12d99b"
    },
    "p32": {
      "id": "p32",
      "system": "cosyvoice3",
      "arm": "pathway_libritts",
      "speaker_id": "6930",
      "target_id": "6930_76324_000003_000000",
      "text": "\"The poor little things!\" cried Cynthia.",
      "icl": "audio/pairs/p32/icl.wav",
      "xvec": "audio/pairs/p32/xvec.wav",
      "reference": "audio/pairs/p32/reference.wav",
      "icl_job_id": "e0255de66bc623e5",
      "xvec_job_id": "9d3758cf6022a136"
    },
    "p33": {
      "id": "p33",
      "system": "cosyvoice3",
      "arm": "pathway_libritts",
      "speaker_id": "1320",
      "target_id": "1320_122612_000006_000004",
      "text": "At last the scout spoke in English, and at once explained the embarrassment of their situation.",
      "icl": "audio/pairs/p33/icl.wav",
      "xvec": "audio/pairs/p33/xvec.wav",
      "reference": "audio/pairs/p33/reference.wav",
      "icl_job_id": "d1692ffaf935199e",
      "xvec_job_id": "050f971a8b01c537"
    },
    "p34": {
      "id": "p34",
      "system": "cosyvoice3",
      "arm": "pathway_libritts",
      "speaker_id": "1995",
      "target_id": "1995_1837_000011_000003",
      "text": "Where was the use of imagining?",
      "icl": "audio/pairs/p34/icl.wav",
      "xvec": "audio/pairs/p34/xvec.wav",
      "reference": "audio/pairs/p34/reference.wav",
      "icl_job_id": "6837e17686685e87",
      "xvec_job_id": "71c9889ae9ed355c"
    },
    "p35": {
      "id": "p35",
      "system": "cosyvoice3",
      "arm": "pathway_libritts",
      "speaker_id": "8230",
      "target_id": "8230_279154_000008_000002",
      "text": "\"Habit\" is a concept involving the occurrence of similar events at different times; if the behaviourist feels confident that there is such a phenomenon as habit, that can only be because he trusts his memory, when it assures him that there have been other times.",
      "icl": "audio/pairs/p35/icl.wav",
      "xvec": "audio/pairs/p35/xvec.wav",
      "reference": "audio/pairs/p35/reference.wav",
      "icl_job_id": "164170c9b1b619eb",
      "xvec_job_id": "22cb6dfb9a312bfb"
    },
    "p36": {
      "id": "p36",
      "system": "cosyvoice3",
      "arm": "pathway_libritts",
      "speaker_id": "2961",
      "target_id": "2961_961_000022_000002",
      "text": "And although you are not immortal you shall not die, for I will hold you together.",
      "icl": "audio/pairs/p36/icl.wav",
      "xvec": "audio/pairs/p36/xvec.wav",
      "reference": "audio/pairs/p36/reference.wav",
      "icl_job_id": "57562302309a5668",
      "xvec_job_id": "fc37eb603ba418f4"
    },
    "p37": {
      "id": "p37",
      "system": "cosyvoice3",
      "arm": "pathway_libritts",
      "speaker_id": "2300",
      "target_id": "2300_131720_000005_000003",
      "text": "It could not be used for electroplating or deposition, nor could it charge storage batteries, all of which are easily within the ability of the direct current.",
      "icl": "audio/pairs/p37/icl.wav",
      "xvec": "audio/pairs/p37/xvec.wav",
      "reference": "audio/pairs/p37/reference.wav",
      "icl_job_id": "482c7abf51cff19b",
      "xvec_job_id": "8cda49249236f9be"
    },
    "p38": {
      "id": "p38",
      "system": "cosyvoice3",
      "arm": "pathway_libritts",
      "speaker_id": "5142",
      "target_id": "5142_33396_000004_000002",
      "text": "But I stayed that spring and built me a boat.",
      "icl": "audio/pairs/p38/icl.wav",
      "xvec": "audio/pairs/p38/xvec.wav",
      "reference": "audio/pairs/p38/reference.wav",
      "icl_job_id": "2fba172ad0baf5c6",
      "xvec_job_id": "0ff728a6dd1815ca"
    },
    "p39": {
      "id": "p39",
      "system": "cosyvoice3",
      "arm": "pathway_libritts",
      "speaker_id": "5683",
      "target_id": "5683_32866_000047_000004",
      "text": "I boldly lighted my cheroot.",
      "icl": "audio/pairs/p39/icl.wav",
      "xvec": "audio/pairs/p39/xvec.wav",
      "reference": "audio/pairs/p39/reference.wav",
      "icl_job_id": "de833ad3c8b1da44",
      "xvec_job_id": "4ca195454a01c52a"
    },
    "p40": {
      "id": "p40",
      "system": "cosyvoice3",
      "arm": "pathway_libritts",
      "speaker_id": "1580",
      "target_id": "1580_141083_000083_000002",
      "text": "He was nearly expelled over a card scandal in his first year.",
      "icl": "audio/pairs/p40/icl.wav",
      "xvec": "audio/pairs/p40/xvec.wav",
      "reference": "audio/pairs/p40/reference.wav",
      "icl_job_id": "d04b20ff92b2aa86",
      "xvec_job_id": "303b4e7d4d08840a"
    },
    "p41": {
      "id": "p41",
      "system": "cosyvoice3",
      "arm": "pathway_libritts",
      "speaker_id": "4077",
      "target_id": "4077_13751_000019_000003",
      "text": "But tools were not wanting, as indeed they never have been, for murder and its kindred outrages.",
      "icl": "audio/pairs/p41/icl.wav",
      "xvec": "audio/pairs/p41/xvec.wav",
      "reference": "audio/pairs/p41/reference.wav",
      "icl_job_id": "e0e6a435fb479715",
      "xvec_job_id": "8a1c02e709b204e4"
    },
    "p42": {
      "id": "p42",
      "system": "cosyvoice3",
      "arm": "pathway_libritts",
      "speaker_id": "1089",
      "target_id": "1089_134691_000007_000001",
      "text": "All through his boyhood he had mused upon that which he had so often thought to be his destiny and when the moment had come for him to obey the call he had turned aside, obeying a wayward instinct.",
      "icl": "audio/pairs/p42/icl.wav",
      "xvec": "audio/pairs/p42/xvec.wav",
      "reference": "audio/pairs/p42/reference.wav",
      "icl_job_id": "e5374430a2f3bd4f",
      "xvec_job_id": "ecf2135adca51abd"
    },
    "p43": {
      "id": "p43",
      "system": "cosyvoice3",
      "arm": "pathway_libritts",
      "speaker_id": "8224",
      "target_id": "8224_274384_000006_000000",
      "text": "\"Why dost thou, tyrant, boast thyself, Thy wicked deeds to praise?\"",
      "icl": "audio/pairs/p43/icl.wav",
      "xvec": "audio/pairs/p43/xvec.wav",
      "reference": "audio/pairs/p43/reference.wav",
      "icl_job_id": "ce294f2352a7192d",
      "xvec_job_id": "6b434103d881db3f"
    },
    "p44": {
      "id": "p44",
      "system": "cosyvoice3",
      "arm": "pathway_libritts",
      "speaker_id": "3575",
      "target_id": "3575_170457_000024_000017",
      "text": "Again I thank you.",
      "icl": "audio/pairs/p44/icl.wav",
      "xvec": "audio/pairs/p44/xvec.wav",
      "reference": "audio/pairs/p44/reference.wav",
      "icl_job_id": "2dd1cde46adf506c",
      "xvec_job_id": "5833258b2df4c5a0"
    },
    "p45": {
      "id": "p45",
      "system": "cosyvoice3",
      "arm": "pathway_seedtts",
      "speaker_id": "common_voice_en_19531363",
      "target_id": "common_voice_en_19531363-common_voice_en_19531364",
      "text": "Castle bids farewell to his associates and faces his death without fear.",
      "icl": "audio/pairs/p45/icl.wav",
      "xvec": "audio/pairs/p45/xvec.wav",
      "reference": "audio/pairs/p45/reference.wav",
      "icl_job_id": "e9b6c26a312b9488",
      "xvec_job_id": "d574b5a80f352d7a"
    },
    "p46": {
      "id": "p46",
      "system": "cosyvoice3",
      "arm": "pathway_seedtts",
      "speaker_id": "common_voice_en_68569",
      "target_id": "common_voice_en_68569-common_voice_en_68571",
      "text": "A large piece suddenly came off and fell with a loud and sharp noise.",
      "icl": "audio/pairs/p46/icl.wav",
      "xvec": "audio/pairs/p46/xvec.wav",
      "reference": "audio/pairs/p46/reference.wav",
      "icl_job_id": "1a672e1b99869615",
      "xvec_job_id": "4dea0325a876811e"
    },
    "p47": {
      "id": "p47",
      "system": "cosyvoice3",
      "arm": "pathway_seedtts",
      "speaker_id": "common_voice_en_20888046",
      "target_id": "common_voice_en_20888046-common_voice_en_20888048",
      "text": "Fox won her next seven fights in a row, with two knockouts.",
      "icl": "audio/pairs/p47/icl.wav",
      "xvec": "audio/pairs/p47/xvec.wav",
      "reference": "audio/pairs/p47/reference.wav",
      "icl_job_id": "cdc36bf5d1de2161",
      "xvec_job_id": "cf062a22812d1294"
    },
    "p48": {
      "id": "p48",
      "system": "cosyvoice3",
      "arm": "pathway_seedtts",
      "speaker_id": "common_voice_en_33322125",
      "target_id": "common_voice_en_33322125-common_voice_en_33322130",
      "text": "Her parents were modest Russian Jewish immigrants who had no background in music.",
      "icl": "audio/pairs/p48/icl.wav",
      "xvec": "audio/pairs/p48/xvec.wav",
      "reference": "audio/pairs/p48/reference.wav",
      "icl_job_id": "6b2a047278a4305a",
      "xvec_job_id": "791c3cd750590c04"
    },
    "p49": {
      "id": "p49",
      "system": "cosyvoice3",
      "arm": "pathway_seedtts",
      "speaker_id": "common_voice_en_19727183",
      "target_id": "common_voice_en_19727183-common_voice_en_19727187",
      "text": "All listings are with original names.",
      "icl": "audio/pairs/p49/icl.wav",
      "xvec": "audio/pairs/p49/xvec.wav",
      "reference": "audio/pairs/p49/reference.wav",
      "icl_job_id": "063113c3bb3fff47",
      "xvec_job_id": "bc3c82c4e3470f8e"
    },
    "p50": {
      "id": "p50",
      "system": "cosyvoice3",
      "arm": "pathway_seedtts",
      "speaker_id": "common_voice_en_17275818",
      "target_id": "common_voice_en_17275818-common_voice_en_17275817",
      "text": "Ladies and gentlemen, this wagon is going to be detached.",
      "icl": "audio/pairs/p50/icl.wav",
      "xvec": "audio/pairs/p50/xvec.wav",
      "reference": "audio/pairs/p50/reference.wav",
      "icl_job_id": "a781e98194ebfcd6",
      "xvec_job_id": "c59fbee426a6824d"
    },
    "p51": {
      "id": "p51",
      "system": "cosyvoice3",
      "arm": "pathway_seedtts",
      "speaker_id": "common_voice_en_652024",
      "target_id": "common_voice_en_652024-common_voice_en_652027",
      "text": "The dragon breathed a stream of fire thirty feet long.",
      "icl": "audio/pairs/p51/icl.wav",
      "xvec": "audio/pairs/p51/xvec.wav",
      "reference": "audio/pairs/p51/reference.wav",
      "icl_job_id": "a3f6f7878cfdfa22",
      "xvec_job_id": "9b276ded65cb1512"
    },
    "p52": {
      "id": "p52",
      "system": "cosyvoice3",
      "arm": "pathway_seedtts",
      "speaker_id": "common_voice_en_30619661",
      "target_id": "common_voice_en_30619661-common_voice_en_30619662",
      "text": "Campbell helped establish branch libraries for Black readers.",
      "icl": "audio/pairs/p52/icl.wav",
      "xvec": "audio/pairs/p52/xvec.wav",
      "reference": "audio/pairs/p52/reference.wav",
      "icl_job_id": "492dfbcc286e2745",
      "xvec_job_id": "8e6164ca22e5254b"
    },
    "p53": {
      "id": "p53",
      "system": "cosyvoice3",
      "arm": "pathway_seedtts",
      "speaker_id": "common_voice_en_565900",
      "target_id": "common_voice_en_565900-common_voice_en_565902",
      "text": "It said that the darkest hour of the night came just before the dawn.",
      "icl": "audio/pairs/p53/icl.wav",
      "xvec": "audio/pairs/p53/xvec.wav",
      "reference": "audio/pairs/p53/reference.wav",
      "icl_job_id": "f6013ca1f8ff9e30",
      "xvec_job_id": "f9ed7bef4fb7a912"
    },
    "p54": {
      "id": "p54",
      "system": "cosyvoice3",
      "arm": "pathway_seedtts",
      "speaker_id": "common_voice_en_613849",
      "target_id": "common_voice_en_613849-common_voice_en_613850",
      "text": "An LED was indicating the proximity detector was working properly.",
      "icl": "audio/pairs/p54/icl.wav",
      "xvec": "audio/pairs/p54/xvec.wav",
      "reference": "audio/pairs/p54/reference.wav",
      "icl_job_id": "380c2212157f345d",
      "xvec_job_id": "7fb3bc4484b256cc"
    },
    "p55": {
      "id": "p55",
      "system": "cosyvoice3",
      "arm": "pathway_seedtts",
      "speaker_id": "common_voice_en_19972684",
      "target_id": "common_voice_en_19972684-common_voice_en_19972725",
      "text": "The meteorite was sent off into the galaxy to be sealed forever.",
      "icl": "audio/pairs/p55/icl.wav",
      "xvec": "audio/pairs/p55/xvec.wav",
      "reference": "audio/pairs/p55/reference.wav",
      "icl_job_id": "200709269e7893c2",
      "xvec_job_id": "d2d371cad758d0fe"
    },
    "p56": {
      "id": "p56",
      "system": "cosyvoice3",
      "arm": "pathway_seedtts",
      "speaker_id": "common_voice_en_20006910",
      "target_id": "common_voice_en_20006910-common_voice_en_20006909",
      "text": "In New Zealand, the rank of superintendent is above inspector and below assistant commissioner.",
      "icl": "audio/pairs/p56/icl.wav",
      "xvec": "audio/pairs/p56/xvec.wav",
      "reference": "audio/pairs/p56/reference.wav",
      "icl_job_id": "664b14998023e40b",
      "xvec_job_id": "f7aadf7c6088b25d"
    },
    "p57": {
      "id": "p57",
      "system": "cosyvoice3",
      "arm": "pathway_seedtts",
      "speaker_id": "common_voice_en_20583510",
      "target_id": "common_voice_en_20583510-common_voice_en_20583514",
      "text": "This new material had stronger alloys in the iron.",
      "icl": "audio/pairs/p57/icl.wav",
      "xvec": "audio/pairs/p57/xvec.wav",
      "reference": "audio/pairs/p57/reference.wav",
      "icl_job_id": "1eb8b69e0867e1b4",
      "xvec_job_id": "73c243b6f2717ee4"
    },
    "p58": {
      "id": "p58",
      "system": "cosyvoice3",
      "arm": "pathway_seedtts",
      "speaker_id": "common_voice_en_565900",
      "target_id": "common_voice_en_565900-common_voice_en_565901",
      "text": "He told them all to be seated.",
      "icl": "audio/pairs/p58/icl.wav",
      "xvec": "audio/pairs/p58/xvec.wav",
      "reference": "audio/pairs/p58/reference.wav",
      "icl_job_id": "910cf18f6302980c",
      "xvec_job_id": "4b6ba132d7ea48ee"
    },
    "p59": {
      "id": "p59",
      "system": "cosyvoice3",
      "arm": "pathway_seedtts",
      "speaker_id": "common_voice_en_19701583",
      "target_id": "common_voice_en_19701583-common_voice_en_19701587",
      "text": "He also obtained the authorizations to fly Predator drones over Yemen.",
      "icl": "audio/pairs/p59/icl.wav",
      "xvec": "audio/pairs/p59/xvec.wav",
      "reference": "audio/pairs/p59/reference.wav",
      "icl_job_id": "43be3eaead9da8d8",
      "xvec_job_id": "436649230748b5a8"
    }
  },
